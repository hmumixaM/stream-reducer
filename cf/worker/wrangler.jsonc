{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stream-reduce",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],

  // Built React SPA (frontend `npm run build` -> ../../frontend/dist).
  // The Worker serves these as static assets and falls back to index.html
  // for client-side routes via the run_worker_first / not_found handling.
  "assets": {
    "directory": "../../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Without this, the static-assets layer answers browser navigations to
    // /api/* (e.g. the magic-link GET /api/auth/verify) with the SPA shell
    // before the Worker runs, so React Router 404s. Run the Worker first for
    // server-handled paths; everything else still falls back to the SPA.
    // The /mcp, /oauth/*, and OAuth discovery (/.well-known/oauth-*) paths are
    // handled by the OAuthProvider that wraps the Worker, so they must run the
    // Worker first too — otherwise the assets layer serves the SPA (GET) or a
    // bare 405 (POST) and the MCP/OAuth endpoints never get reached.
    "run_worker_first": [
      "/api/*",
      "/media/*",
      "/mcp",
      "/mcp/*",
      "/oauth/*",
      "/.well-known/oauth-authorization-server",
      "/.well-known/oauth-authorization-server/*",
      "/.well-known/oauth-protected-resource",
      "/.well-known/oauth-protected-resource/*"
    ]
  },

  "observability": { "enabled": true },

  // The pipeline queue consumer orchestrates a long streaming container run
  // (download -> transcribe -> summarize), shuttling progress + transcript
  // through the Worker. The default 30s CPU cap killed heavy items mid-run
  // (outcome: exceededCpu), which strands them in-progress with no error and no
  // chance for the in-run watchdog/timeouts to fire. Give the orchestrator
  // headroom (Workers Paid allows up to 300s of CPU per invocation).
  "limits": { "cpu_ms": 300000 },

  // The Worker is served from the custom domain reducer.xgoose.org. That domain
  // is attached out-of-band via the Workers Custom Domains API (the CI deploy
  // token can't manage zone-level Workers routes), so it is intentionally NOT
  // declared here — declaring it makes `wrangler deploy` fail with a zone-route
  // auth error. The attached domain persists independently of deploys.

  // --- D1: relational store (users, items, user_item, subs, comments, ...) ---
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stream_reduce",
      "database_id": "60e0f618-ad5c-41ab-88d5-7099f526809a",
      "migrations_dir": "migrations"
    }
  ],

  // --- Vectorize: semantic search over chunk embeddings ---
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "stream-reduce-chunks"
    }
  ],

  // --- Workers AI: embeddings (bge-m3) used to fill Vectorize ---
  "ai": { "binding": "AI" },

  // --- R2: downloaded audio media ---
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "stream-reduce-media"
    }
  ],

  // --- KV: OAuth clients, tokens, and grants + Bilibili auth (cookie + token) ---
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "bfba6f4a3950488cb4b0ba9b84e2b879"
    },
    {
      "binding": "BILI_AUTH",
      "id": "b2a287d7866842ef864246119d2e3c72"
    }
  ],

  // --- Queues: pipeline jobs (ingest/transcribe/summarize/embed) ---
  "queues": {
    "producers": [{ "binding": "PIPELINE", "queue": "stream-reduce-pipeline" }],
    "consumers": [
      {
        "queue": "stream-reduce-pipeline",
        "max_batch_size": 1,
        // Each job runs in its own container instance (job-<id>). Keep parallel
        // jobs WELL BELOW `containers[].max_instances` so there's headroom for
        // the auxiliary containers that also share the pool — subscription feed
        // enumeration (`feed-<shard>`, FEED_SHARDS of them), the daily Bilibili
        // cookie refresh (`bili-refresh`), metadata (`meta-*`), and
        // `proxy-check`. 8 jobs left too little headroom: a poll burst spawned
        // enough `meta-*`/`feed` instances to push past max_instances and trip
        // "Maximum number of running container instances exceeded". (Capacity
        // errors are also self-healed now: the consumer re-queues the item
        // instead of failing it.)
        // Temporary AI4 backlog burst: RightCode's gemini-3.7-flash route can
        // sustain the fan-out from six concurrent summarization jobs. Reduce
        // this to 2 again after the conference backlog has drained.
        "max_concurrency": 6,
        // The consumer gives up on the fifth content failure. Queue redelivery
        // must allow it to reach that terminal decision; three retries stopped
        // one attempt early and left items stranded in "summarizing".
        "max_retries": 5,
        "dead_letter_queue": "stream-reduce-pipeline-dlq"
      }
    ]
  },

  // --- Container: Python pipeline (yt-dlp + ffmpeg + summarize) ---
  // Controlled per-instance through the PipelineContainer Durable Object.
  "containers": [
    {
      "class_name": "PipelineContainer",
      "image": "../pipeline/Dockerfile",
      // Build from the repo root so the Dockerfile can COPY the shared `app/`
      // package (adapters) alongside cf/pipeline/*.py.
      "image_build_context": "../../",
      // Most stages are I/O-bound, but ffmpeg must decode/transcode multi-hour
      // podcast audio. On "basic" (1/4 vCPU, 1 GiB), a 3.6-hour episode spent
      // ~30 minutes preparing chunks and outlived the Worker invocation. Use the
      // 1-vCPU tier for about 4x the throughput. Though standard-2 provisions
      // 6 GiB, one successful ~8-minute run costs far fewer memory-seconds than
      // repeatedly restarting a ~30-minute basic run (these items had 6–8
      // failed attempts each).
      "instance_type": "standard-2",
      // Total container slots, sized as queue max_concurrency (6) + FEED_SHARDS
      // (3) + the aux singletons (bili-refresh / meta-* / proxy-check) + spare.
      // At 10 the pool had no spare: a summarize retry burst filled all six job
      // slots and the feed shards then lost every slot, so healthy channels
      // polled into "no Container instance available"/"suddenly disconnected"
      // for over an hour. Instances are billed only while running and the
      // account ceiling is far higher (6 TiB / 1,500 vCPU concurrent), so the
      // headroom is free unless it is actually used.
      "max_instances": 16
    }
  ],

  "durable_objects": {
    "bindings": [
      { "class_name": "PipelineContainer", "name": "PIPELINE_CONTAINER" }
    ]
  },

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PipelineContainer"] }
  ],

  // --- Email Service: magic-link sign-in ---
  "send_email": [{ "name": "EMAIL" }],

  // --- Cron: poll subscriptions (hourly) + nightly graph rebuild ---
  "triggers": {
    "crons": ["*/15 * * * *", "0 4 * * *"]
  },

  "vars": {
    "APP_ORIGIN": "https://reducer.xgoose.org",
    "EMAIL_FROM": "noreply@xgoose.org",
    // OpenAI-compatible LiteLLM deployment. Its gemini-3.7-flash alias routes
    // through RightCode instead of the failure-prone Gemini web reverse proxy.
    // Verify the live route with `GET /api/admin/llm-check`.
    "LLM_BASE_URL": "https://xgoose-litellm.max-678.workers.dev/v1",
    "LLM_MODEL": "gemini-3.7-flash",
    // Keep the older route as a last-resort fallback for transient RightCode
    // failures. Empty/diagnostic responses are rejected by cf/pipeline/llm.py.
    "LLM_MODEL_FALLBACK": "gemini-3.5-flash",
    "LLM_MODEL_INFOGRAPHIC": "gemini-3-pro-image-preview",
    "STT_MODEL": "openai/whisper-large-v3-turbo",
    "EMBEDDING_DIM": "1024",
    // How far back a new follow backfills on its first poll.
    "SUBSCRIPTION_WINDOW_DAYS": "60",
    // Shortest video a subscription poll will pick up on its own: below this a
    // channel's clips and teasers aren't worth a transcribe. Adding a URL by
    // hand ignores this floor — an explicit request is always honoured.
    "SUBSCRIPTION_MIN_DURATION_S": "300",
    "GRAPH_KNN_K": "6",
    "GRAPH_SIM_THRESHOLD": "0.6",
    "ADMIN_EMAILS": "huyangmax@gmail.com",
    // NAS advertises a Tailscale exit node; YouTube uses it as the residential
    // fallback after direct egress and before datacenter WARP addresses.
    "TS_EXIT_NODE": "100.77.236.1",
    // Bump to force all container jobs onto fresh instances (new image) after a
    // deploy — avoids long-lived DO instances running a stale container image.
    "CONTAINER_GEN": "30"
  }

  // Secrets (set via `wrangler secret put`):
  //   GEMINI_API_KEY        - bearer token for the Gemini summary proxy
  //   OPENROUTER_API_KEY    - OpenRouter key for Whisper STT
  //   GEMINI_IMAGE_API_KEY  - Google AI Studio key for infographic image gen
  //                           (native generateContent; the text proxy can't emit
  //                           images). Optional: falls back to GEMINI_API_KEY.
  //   TS_AUTHKEY            - OAuth client secret for ephemeral Tailscale nodes
  //   YOUTUBE_COOKIE        - browser cookie header, used only over Tailscale
}
